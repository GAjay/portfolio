#!/bin/sh
# Remove Cursor agent co-author trailer so GitHub credits only GAjay.
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0
case "$(uname)" in
  Darwin) sed -i '' '/^Co-authored-by: Cursor <cursoragent@cursor.com>$/d' "$MSG_FILE" ;;
  *) sed -i '/^Co-authored-by: Cursor <cursoragent@cursor.com>$/d' "$MSG_FILE" ;;
esac
